{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiendario",
  "keep_vars": true,
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
