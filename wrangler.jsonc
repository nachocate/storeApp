{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiendario",
  "keep_vars": true,
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-16",
  "observability": {
    "enabled": true
  },
  // Contact form abuse protection: 5 inquiries per minute per IP and Cloudflare location.
  "ratelimits": [
    {
      "name": "VENDOR_INQUIRY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
