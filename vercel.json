{
  "rewrites": [
    {
      "source": "/api/v1/vendor-inquiries",
      "destination": "/api/vendor-inquiries"
    },
    {
      "source": "/api/v1/stores/:storeSlug/:path+",
      "destination": "/api/store?storeSlug=:storeSlug&path=:path*"
    },
    {
      "source": "/:storeSlug",
      "destination": "/index.html"
    }
  ]
}